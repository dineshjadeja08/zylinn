# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-key-here

# STT Configuration (Optional - uses mock if not provided)
STT_PROVIDER=assemblyai  # Options: assemblyai, whisper, mock
STT_API_KEY=your_stt_api_key_here

# TTS Configuration (Optional - uses gtts fallback if not provided)
TTS_PROVIDER=elevenlabs  # Options: elevenlabs, azure, gtts, mock
TTS_API_KEY=your_elevenlabs_api_key_here  # Get from https://elevenlabs.io/app/settings/api-keys
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (default) - other options: EXAVITQu4vr4xnSDxMaL (Bella), MF3mGyEYCl7XYWbV9V6O (Elli)
# Popular ElevenLabs voices:
# - 21m00Tcm4TlvDq8ikWAM: Rachel (professional, clear)
# - EXAVITQu4vr4xnSDxMaL: Bella (friendly, warm)
# - MF3mGyEYCl7XYWbV9V6O: Elli (young, energetic)
# - TxGEqnHWrfWFTfGW9XjX: Josh (male, deep)
# Find more voices at: https://elevenlabs.io/voice-library

# Backend Configuration
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./zylin.db
# For PostgreSQL: postgresql://user:password@localhost:5432/zylin

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR

# Agent Configuration
AGENT_NAME=zylin-agent
VAD_SILENCE_THRESHOLD_MS=1500  # Silence duration before end-of-turn
