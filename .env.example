# =============================================================================
# Zylinn V1 — Environment Variables Reference
# Copy this file to .env (dev) or .env.production (prod) and fill in values.
# =============================================================================

# ---------------------------------------------------------------------------
# LiveKit (Real-time audio rooms)
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ---------------------------------------------------------------------------
# LLM
# Supported providers: openai (default)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini          # gpt-4o-mini (cheaper) or gpt-4o (best quality)
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=200

# ---------------------------------------------------------------------------
# STT — Speech-to-Text
# Supported providers: sarvam (default), deepgram, assemblyai, whisper, mock
# ---------------------------------------------------------------------------
STT_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key

# Languages to enable (comma-separated). 
# "ta,en" = Tamil + English code-switching (recommended for India)
# "en"    = English only
STT_LANGUAGES=ta,en

# ---------------------------------------------------------------------------
# TTS — Text-to-Speech
# Supported providers: sarvam (default), elevenlabs, azure_neural, mock
# ---------------------------------------------------------------------------
TTS_PROVIDER=sarvam
# Uses SARVAM_API_KEY from above

# Azure (Tamil TTS — REQUIRED for Tamil support)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia    # Use southeastasia or centralindia for low latency
# Tamil voices: ta-IN-PallaviNeural (female), ta-IN-ValluvarNeural (male)
AZURE_TAMIL_VOICE=ta-IN-PallaviNeural

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://zylin_user:changeme@localhost:5432/zylin
# SQLite for local dev only:
# DATABASE_URL=sqlite:///./zylin.db

DB_PASSWORD=changeme_generate_strong_password

# ---------------------------------------------------------------------------
# Redis (session store, task queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme_generate_strong_password

# ---------------------------------------------------------------------------
# Auth & Security
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_SALT=change-this-to-a-different-64-char-random-string

# ---------------------------------------------------------------------------
# Email (SendGrid)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Zylinn

# ---------------------------------------------------------------------------
# Telephony
# Supported providers: exotel (default), twilio
# ---------------------------------------------------------------------------
TELEPHONY_PROVIDER=exotel
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SID=your_exotel_sid
EXOTEL_VIRTUAL_NUMBER=080XXXXXXX

# Twilio fallback:
# TELEPHONY_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ---------------------------------------------------------------------------
# Messaging (WhatsApp)
# Supported providers: meta (default), twilio
# ---------------------------------------------------------------------------
MESSAGING_PROVIDER=meta
META_WHATSAPP_TOKEN=your_meta_whatsapp_token
META_PHONE_NUMBER_ID=your_phone_id
META_BUSINESS_ACCOUNT_ID=your_biz_id

# ---------------------------------------------------------------------------
# Storage — Call Recordings
# Cloudflare R2 recommended (zero egress cost for India traffic)
# ---------------------------------------------------------------------------
RECORDING_STORAGE=s3               # s3 or r2
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_DEFAULT_REGION=ap-south-1
RECORDING_BUCKET=zylinn-recordings

# Cloudflare R2 (alternative — set RECORDING_STORAGE=r2):
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_key
# R2_SECRET_ACCESS_KEY=your_r2_secret
# R2_BUCKET=zylinn-recordings

# ---------------------------------------------------------------------------
# Billing
# Supported providers: razorpay (default), stripe
# ---------------------------------------------------------------------------
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Plan IDs
RAZORPAY_PLAN_STARTER=plan_xxx    # ₹2,999/mo
RAZORPAY_PLAN_PRO=plan_xxx        # ₹7,999/mo
RAZORPAY_PLAN_SCALE=plan_xxx      # ₹19,999/mo

# Stripe fallback:
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_your_stripe_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_PRICE_STARTER=price_xxx    
# STRIPE_PRICE_PRO=price_xxx        
# STRIPE_PRICE_SCALE=price_xxx

# ---------------------------------------------------------------------------
# Agent Configuration
# ---------------------------------------------------------------------------
AGENT_NAME=Zylinn
VAD_SILENCE_THRESHOLD_MS=1000    # End-of-turn silence (ms). 1000ms works well for Tamil
LLM_SYSTEM_PROMPT=appointment    # default | appointment | customer_service

# ---------------------------------------------------------------------------
# Logging & Monitoring
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
ENVIRONMENT=development          # development | staging | production

# Grafana (monitoring)
GRAFANA_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Secrets Management (optional — for production)
# ---------------------------------------------------------------------------
# AWS Secrets Manager:
# AWS_SECRETS_REGION=ap-south-1
# AWS_SECRET_NAME=zylinn/production

# HashiCorp Vault:
# VAULT_ADDR=https://vault.yourdomain.com
# VAULT_TOKEN=your_vault_token

# ---------------------------------------------------------------------------
# Backup (optional)
# ---------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=zylinn-backups
